# Auto-detect text files and normalize line endings
* text=auto

# Source code
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.svg binary
*.ico binary
*.pt binary
*.bin binary
*.zip binary
